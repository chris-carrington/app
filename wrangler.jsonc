// app/wrangler.jsonc

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "ENVIRONMENT",
      "ORIGIN",
      "COOKIE_SECRET",
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "TURSO_CLOUD_DATA",
      "CLOUDFLARE_EMAIL_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
    ]
  },
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "main"
    }
  ],
  "routes": [
    {
      "pattern": "shastatrades.org/*",
      "zone_id": "29031d04d1493e499d5a56001c093079"
    },
    {
      "pattern": "www.shastatrades.org/*",
      "zone_id": "29031d04d1493e499d5a56001c093079"
    }
  ]
}
