{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.tsx",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "routes": [
    {
      "pattern": "shastatrades.org/*",
      "zone_name": "shastatrades.org"
    },
    {
      "pattern": "www.shastatrades.org/*",
      "zone_name": "shastatrades.org"
    }
  ]
}