{
  "include": [
    "src",
    "npm",
    "drizzle.config.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": [
      "DOM",
      "ESNext",
    ],
    "types": [
      "vite/client",
      "./worker-configuration.d.ts",
      "node"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@src/*": [
        "./src/*"
      ],
      "@hono-toast": [
        "./npm/hono-toast/index"
      ],
      "@hono-directives": [
        "./npm/hono-directives/dist/index"
      ],
      "@hono-security": [
        "./npm/hono-security/index"
      ],
      "@send-cloudflare-email": [
        "./npm/send-cloudflare-email/index"
      ]
    }
  },
}
