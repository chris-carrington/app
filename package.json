{
  "name": "app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",

    "build": "npm run build:cf-types && npm run build:hono-directives && npm run build:app-types && vite build",
    "build:cf-types": "npx wrangler types",
    "build:hono-directives": "npx tsx npm/hono-directives/src/cli.ts",
    "build:app-types": "tsc --noEmit",
    "build:hono-email-preview-script": "node npm/hono-email/src/build.js",

    "cf:secret:put": "npx wrangler secret put",
    "cf:secret:delete": "npx wrangler secret delete",

    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npx tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.6.1",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "marked": "^18.0.7",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-solid": "^2.11.14",
    "vite-ssr-components": "^0.6.1",
    "wrangler": "^4.119.0"
  }
}
